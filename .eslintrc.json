{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "plugins": ["security"],
  "extends": ["plugin:security/recommended-legacy"],
  "rules": {
    "security/detect-object-injection": "off",
    "security/detect-non-literal-regexp": "error",
    "no-eval": "error",
    "no-implied-eval": "error"
  }
}